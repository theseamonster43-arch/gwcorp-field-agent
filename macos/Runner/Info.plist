<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- CoreLocation refuses a request from an app with no usage description,
	     and does it quietly — the app just never receives a fix, which surfaced
	     as "could not get your location" with nothing in the logs. The same
	     applies to the camera and microphone, which the scanner and the voice
	     assistant need. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location is used to find disposal sites near you and to give directions.</string>
	<key>NSLocationUsageDescription</key>
	<string>Your location is used to find disposal sites near you and to give directions.</string>
	<key>NSCameraUsageDescription</key>
	<string>The camera is used to photograph waste for classification.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>The microphone is used for the voice assistant.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech recognition turns your spoken questions into text for the assistant.</string>
	<!-- Google sign-in opens a browser and then redirects back to the app on a
	     custom scheme. Without this the redirect has nowhere to land: the login
	     succeeds in the browser while the app sits there still asking you to
	     sign in. The scheme is the iOS client id reversed, which is the format
	     Google issues — see iosClientId in firebase_options.dart. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>Google Sign-In</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.338927356213-mnnae55jr3dqvhdqhm9751nt9ffc456o</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>GWCORP handoff</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>gwcorp</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
