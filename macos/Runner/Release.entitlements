<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox off. The app is distributed outside the App Store and signed
	     ad-hoc, so it has no team identifier — and a sandboxed app without one
	     cannot be granted a keychain group. Turn this back on if it ever ships
	     through the App Store, alongside a real signing identity. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- No keychain-access-groups here, deliberately.
	     A group must be prefixed with a real team identifier. Declaring a bare
	     bundle id made the ad-hoc signature invalid, and the app stopped
	     launching entirely: "Launch failed / Launchd job spawn failed"
	     (POSIX 162). Outside the sandbox the app reaches the login keychain
	     without a group, so none is needed. Add one only together with a
	     Developer ID, where $(AppIdentifierPrefix) actually resolves. -->

	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
