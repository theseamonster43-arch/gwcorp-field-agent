<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Without this the sandbox blocks every outbound request in a release
	     build: Firebase, the maps proxy, the update check. Debug builds get it
	     from DebugProfile.entitlements, so the failure only appears once the
	     app is shipped. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Satellite asks for the agent's position. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
