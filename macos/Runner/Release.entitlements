<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox off. The app is distributed outside the App Store and signed
	     ad-hoc, so it has no team identifier — and a sandboxed app without one
	     cannot be granted a keychain group. Turn this back on if it ever ships
	     through the App Store, alongside a real signing identity. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Firebase Auth keeps its tokens in the keychain. Without a declared
	     access group macOS refuses the app one, which surfaces as
	     "An error occurred when accessing the keychain" on every sign-in.
	     Ad-hoc signing leaves AppIdentifierPrefix empty, so the group is the
	     bundle id on its own rather than $(AppIdentifierPrefix)-prefixed. -->
	<key>keychain-access-groups</key>
	<array>
		<string>com.gwcorp.gwcorpFieldAgent</string>
	</array>

	<!-- Meaningless with the sandbox off, correct the moment it returns. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
